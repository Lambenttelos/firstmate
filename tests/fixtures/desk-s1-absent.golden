  <section id="sec-decisions" class="mb-10">
    <h2 class="text-lg font-semibold mb-3">1. Decisions needed</h2>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="card bg-base-200 rail" style="--rail: oklch(0.75 0.16 70)">
        <div class="card-body gap-2">
          <div class="flex items-start justify-between gap-2">
            <h3 class="card-title text-base">Decide alpha</h3>
            <span class="flex gap-1 shrink-0"><span class="badge badge-warning badge-sm">your call</span></span>
          </div>
          <details class="text-sm opacity-80 group">
            <summary class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden">
              <span class="align-middle">pick a data store</span>
            </summary>
          </details>
          <div class="text-xs opacity-50">scout</div>
        </div>
      </div>
      <div class="card bg-base-200 rail" style="--rail: oklch(0.75 0.16 70)">
        <div class="card-body gap-2">
          <div class="flex items-start justify-between gap-2">
            <h3 class="card-title text-base">Decide pay rename</h3>
            <span class="flex gap-1 shrink-0"><span class="badge badge-error badge-sm">money</span><span class="badge badge-warning badge-sm">your call</span></span>
          </div>
          <details class="text-sm opacity-80 group">
            <summary class="cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden">
              <span class="align-middle">confirm the pricing rename</span>
            </summary>
          </details>
          <div class="text-xs opacity-50">scout</div>
        </div>
      </div>
    </div>
  </section>
